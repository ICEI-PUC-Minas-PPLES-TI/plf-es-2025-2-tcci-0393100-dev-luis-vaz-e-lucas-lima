opam-version: "2.0"
name: "app-scrappers"
version: "0.1.0"
synopsis: "BusCars Scraper Orchestrator"
description: "Automated scraper orchestrator for BusCars platform"
maintainer: "BusCars Team"
authors: ["BusCars Team"]
license: "MIT"
homepage: "https://github.com/buscars/app-scrappers"
bug-reports: "https://github.com/buscars/app-scrappers/issues"
depends: [
  "dune" {>= "3.0"}
  "lwt" {>= "5.0"}
  "lwt_ppx"
  "curl" {>= "0.9.0"}
  "curl_lwt" {>= "0.9.0"}
  "yojson" {>= "2.0"}
  "uri" {>= "4.0"}
  "logs" {>= "0.7"}
  "fmt"
  "ppx_deriving_yojson"
  "re" {>= "1.10"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/buscars/app-scrappers.git"

